  "profiles": {
    "Python": {
      "icon": "code",
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "ms-python.vscode-python-envs"
      ]
    },
    "Data Science": {
      "icon": "graph",
      "extends": "Python",
      "extensions": [
        "ms-toolsai.jupyter",
        "ms-toolsai.jupyter-renderers",
        "ms-toolsai.datawrangler",
        "quarto.quarto",
        "mechatroner.rainbow-csv",
        "qwtel.sqlite-viewer"
      ]
    },
    "Web": {
      "icon": "globe",
      "extensions": ["ms-vscode.live-server"]
    },
    "Docs": {
      "icon": "book",
      "extensions": ["james-yu.latex-workshop", "myriad-dreamin.tinymist", "quarto.quarto"]
    }
  }
}
