# Machine-wide defaults (copied to the home folder by windows/link.ps1). Projects can override.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{py,pyi}]
indent_size = 4
max_line_length = 88

[*.{ps1,psm1,psd1}]
indent_size = 4

# Two trailing spaces are a hard line break in Markdown
[*.{md,qmd}]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
